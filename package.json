{
  "name": "agent-stream-deck-neo-claude-code-codex",
  "version": "0.3.1",
  "description": "Turn a Stream Deck Neo into a focused Claude Code and Codex session console.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mike",
    "url": "https://github.com/mike-ai-de"
  },
  "contributors": [
    {
      "name": "Manuel Burgschachner",
      "url": "https://github.com/m-a-b-u"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-ai-de/agent-stream-deck-neo-claude-code-codex.git"
  },
  "bugs": {
    "url": "https://github.com/mike-ai-de/agent-stream-deck-neo-claude-code-codex/issues"
  },
  "homepage": "https://github.com/mike-ai-de/agent-stream-deck-neo-claude-code-codex#readme",
  "keywords": [
    "stream-deck",
    "stream-deck-neo",
    "elgato",
    "claude-code",
    "codex",
    "agent",
    "hid",
    "macos",
    "windows",
    "linux"
  ],
  "engines": {
    "node": ">=22 <23 || >=24"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "check": "npm run build && tsc -p tsconfig.test.json && npm test",
    "dev": "tsx src/index.ts",
    "doctor": "tsx scripts/doctor.ts",
    "install:linux": "bash scripts/install-linux.sh",
    "install:mac": "bash scripts/install-macos.sh",
    "install:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "preview": "tsx scripts/preview.ts",
    "preview:docs": "tsx scripts/preview.ts --readme",
    "setup": "tsx scripts/setup.ts",
    "preview:live": "tsx scripts/preview.ts --live",
    "status": "tsx scripts/status.ts",
    "uninstall:linux": "bash scripts/uninstall-linux.sh",
    "uninstall:mac": "bash scripts/uninstall-macos.sh",
    "uninstall:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
